        "# ------------------------------\n",
        "# Phishing/Spam Text Classifier\n",
        "# Beginner-friendly Colab notebook\n",
        "# ------------------------------\n",
        "\n",
        "# 0) Environment check & installs (scikit-learn is available by default in Colab)\n",
        "print(\"Ready. Python version:\", __import__(\"sys\").version)\n",
        "\n",
        "# 1) Download a public text-spam dataset (UCI SMS Spam Collection)\n",
        "# This dataset is commonly used for spam detection exercises and works well for a beginner text classifier.\n",
        "import os, urllib.request, zipfile\n",
        "\n",
        "DATA_DIR = \"data\"\n",
        "os.makedirs(DATA_DIR, exist_ok=True)\n",
        "\n",
        "url = \"https://archive.ics.uci.edu/ml/machine-learning-databases/00228/smsspamcollection.zip\"\n",
        "zip_path = os.path.join(DATA_DIR, \"smsspamcollection.zip\")\n",
        "txt_path = os.path.join(DATA_DIR, \"SMSSpamCollection\")\n",
        "\n",
        "if not os.path.exists(txt_path):\n",
        "    print(\"Downloading dataset...\")\n",
        "    urllib.request.urlretrieve(url, zip_path)\n",
        "    with zipfile.ZipFile(zip_path, \"r\") as z:\n",
        "        z.extractall(DATA_DIR)\n",
        "    print(\"Downloaded and extracted to\", DATA_DIR)\n",
        "else:\n",
        "    print(\"Dataset already present at\", txt_path)\n",
        "\n",
        "# 2) Load dataset into pandas\n",
        "import pandas as pd\n",
        "df = pd.read_csv(txt_path, sep=\"\\t\", header=None, names=[\"label\", \"text\"])\n",
        "df[\"label\"] = df[\"label\"].map({\"ham\": 0, \"spam\": 1})  # 0 = normal, 1 = spam/phishing-like\n",
        "print(\"Dataset shape:\", df.shape)\n",
        "print(df.head(6).to_string(index=False))\n",
        "\n",
        "# 3) Quick preprocessing: lowercasing, basic cleaning\n",
        "import re\n",
        "def clean_text(s):\n",
        "    s = str(s).lower()\n",
        "    s = re.sub(r\"http\\S+\", \" \", s)         # remove urls\n",
        "    s = re.sub(r\"[^a-z0-9\\s@#\\$%&\\-\\._]\", \" \", s)  # keep letters and numbers\n",
        "    s = re.sub(r\"\\s+\", \" \", s).strip()\n",
        "    return s\n",
        "\n",
        "df[\"text_clean\"] = df[\"text\"].apply(clean_text)\n",
        "print(\"\\nSample cleaned text:\")\n",
        "print(df[[\"text\", \"text_clean\"]].head(5).to_string(index=False))\n",
        "\n",
        "# 4) Train/test split\n",
        "from sklearn.model_selection import train_test_split\n",
        "X = df[\"text_clean\"]\n",
        "y = df[\"label\"]\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42, stratify=y)\n",
        "print(\"\\nTrain/Test sizes:\", X_train.shape[0], X_test.shape[0])\n",
        "\n",
        "# 5) Feature extraction: TF-IDF\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "tfidf = TfidfVectorizer(ngram_range=(1,2), min_df=2, max_df=0.9)\n",
        "X_train_tfidf = tfidf.fit_transform(X_train)\n",
        "X_test_tfidf = tfidf.transform(X_test)\n",
        "print(\"TF-IDF shape (train):\", X_train_tfidf.shape)\n",
        "\n",
        "# 6) Train a simple classifier (Logistic Regression)\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "clf = LogisticRegression(max_iter=1000)\n",
        "clf.fit(X_train_tfidf, y_train)\n",
        "print(\"Model trained.\")\n",
        "\n",
        "# 7) Evaluate\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix, classification_report\n",
        "y_pred = clf.predict(X_test_tfidf)\n",
        "\n",
        "metrics = {\n",
        "    \"accuracy\": accuracy_score(y_test, y_pred),\n",
        "    \"precision\": precision_score(y_test, y_pred, zero_division=0),\n",
        "    \"recall\": recall_score(y_test, y_pred, zero_division=0),\n",
        "    \"f1\": f1_score(y_test, y_pred, zero_division=0)\n",
        "}\n",
        "print(\"\\nEvaluation metrics:\")\n",
        "print(pd.Series(metrics).round(3))\n",
        "\n",
        "print(\"\\nClassification report:\\n\")\n",
        "print(classification_report(y_test, y_pred, target_names=[\"ham\",\"spam\"]))\n",
        "\n",
        "print(\"Confusion matrix (rows=true, cols=pred):\")\n",
        "print(confusion_matrix(y_test, y_pred))\n",
        "\n",
        "# 8) Save sample predictions + metrics\n",
        "os.makedirs(\"results\", exist_ok=True)\n",
        "sample_output = pd.DataFrame({\n",
        "    \"text\": X_test,\n",
        "    \"text_clean\": X_test.apply(clean_text).values,\n",
        "    \"label_true\": y_test.values,\n",
        "    \"label_pred\": y_pred\n",
        "})\n",
        "sample_output.to_csv(\"results/sample_predictions.csv\", index=False)\n",
        "import json\n",
        "with open(\"results/model_metrics.json\", \"w\") as f:\n",
        "    json.dump(metrics, f, indent=2)\n",
        "\n",
        "print(\"\\nSaved results/sample_predictions.csv and results/model_metrics.json\")\n",
        "\n",
        "# 9) Show top model features for interpretability\n",
        "import numpy as np\n",
        "feature_names = tfidf.get_feature_names_out()\n",
        "coefs = clf.coef_[0]\n",
        "top_pos_idx = np.argsort(coefs)[-20:][::-1]\n",
        "top_neg_idx = np.argsort(coefs)[:20]\n",
        "print(\"\\nTop positive features (spam indicators):\")\n",
        "for i in top_pos_idx[:20]:\n",
        "    print(feature_names[i], round(coefs[i],3))\n",
        "print(\"\\nTop negative features (ham indicators):\")\n",
        "for i in top_neg_idx[:20]:\n",
        "    print(feature_names[i], round(coefs[i],3))\n",
        "\n",
        "# 10) Quick visualization: confusion matrix heatmap (matplotlib)\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "cm = confusion_matrix(y_test, y_pred)\n",
        "plt.figure(figsize=(5,4))\n",
        "sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", xticklabels=[\"ham\",\"spam\"], yticklabels=[\"ham\",\"spam\"])\n",
        "plt.xlabel(\"Predicted\")\n",
        "plt.ylabel(\"True\")\n",
        "plt.title(\"Confusion Matrix\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"results/confusion_matrix.png\")\n",
        "plt.show()\n",
        "print(\"\\nConfusion matrix image saved to results/confusion_matrix.png\")\n",
        "\n",
        "# 11) Instructions to download the files from Colab\n",
        "print(\"\\nWhen the notebook finishes, open the left-hand Files panel in Colab, expand 'results', right-click and 'Download' the files:\\n - results/sample_predictions.csv\\n - results/model_metrics.json\\n - results/confusion_matrix.png\\n\\nThese are the artifacts you can include in your portfolio/README.\")\n",
        "\n",
        "# 12) Short README content generator (saves a small README)\n",
        "readme = f\"\"\"\n",
        "Phishing / Spam Text Classifier (Beginner)\n",
        "-----------------------------------------\n",
        "Dataset: UCI SMS Spam Collection\n",
        "Model: LogisticRegression on TF-IDF features (uni+bi-grams)\n",
        "Train/Test split: 75%/25%\n",
        "\n",
        "Key metrics:\n",
        "{json.dumps(metrics, indent=2)}\n",
        "\n",
        "Files:\n",
        "- results/sample_predictions.csv : sample test rows with predictions\n",
        "- results/model_metrics.json : saved evaluation metrics\n",
        "- results/confusion_matrix.png : confusion matrix figure\n",
        "\n",
        "Notes:\n",
        "- This is a beginner, browser-friendly project to demonstrate text classification skills.\n",
        "- Use larger datasets and more advanced models for production use.\n",
        "\"\"\"\n",
        "with open(\"results/README_project.txt\", \"w\") as f:\n",
        "    f.write(readme)\n",
        "print(\"Saved a short README at results/README_project.txt\")\n"
      ]
    }
